---
import ContactForm from '../components/sections/ContactForm.astro';
import PageHead from '../components/ui/PageHead.astro';
import { site } from '../config/site';
import type { Locale } from '../i18n/config';
import { alternatesFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = useTranslations(locale).contact;
---

<BaseLayout locale={locale} alternates={alternatesFor('contact')} title={c.title} description={c.description}>
  <PageHead num={c.num} lines={c.heading} accent={c.headingAccent} intro={c.intro} />

  <div class="contact">
    <ContactForm locale={locale} />

    <aside class="panel">
      <div class="panel__block panel__block--mail">
        <h2 class="panel__label">{c.asideEmail}</h2>
        <a class="panel__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="panel__block">
        <h2 class="panel__label">{c.asideInclude}</h2>
        <ol class="panel__list">
          {c.include.map((item) => <li>{item}</li>)}
        </ol>
      </div>
      <div class="panel__mark" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          <rect x="1" y="1" width="198" height="198" fill="none" stroke="currentColor" stroke-width="2"></rect>
          <line x1="0" y1="100" x2="200" y2="100" stroke="currentColor" stroke-dasharray="2 4" opacity=".5"></line>
          <line x1="100" y1="0" x2="100" y2="200" stroke="currentColor" stroke-dasharray="2 4" opacity=".5"></line>
          <rect x="68" y="68" width="64" height="64" fill="currentColor"></rect>
          <rect x="82" y="82" width="36" height="36" class="panel__accent"></rect>
        </svg>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    border-bottom: var(--bw) solid var(--c-line);
  }
  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: 1.4fr 1fr;
    }
    .contact :global(.form) {
      border-right: var(--bw) solid var(--c-line);
    }
  }

  .panel {
    display: grid;
    grid-template-rows: auto auto 1fr;
    border-top: var(--bw) solid var(--c-line);
  }
  @media (min-width: 64rem) {
    .panel {
      border-top: 0;
    }
  }
  .panel__block {
    padding: var(--s-6) var(--pad-x);
    border-bottom: var(--bw) solid var(--c-line);
    display: grid;
    gap: var(--s-3);
  }
  .panel__block--mail {
    background: var(--c-inverse-bg);
    color: var(--c-inverse-fg);
  }
  .panel__label {
    font-family: var(--ff-mono);
    font-size: var(--fs-mono-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }
  .panel__mail {
    font-family: var(--ff-display);
    font-size: clamp(1.375rem, 3cqi, 2.25rem);
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--c-inverse-accent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }
  .panel__mail:hover {
    color: var(--c-inverse-accent);
  }
  .panel__list {
    padding: 0;
    list-style: none;
    counter-reset: inc;
    display: grid;
    gap: var(--s-3);
  }
  .panel__list li {
    counter-increment: inc;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
  }
  .panel__list li::before {
    content: '[' counter(inc, decimal-leading-zero) ']';
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    color: var(--c-fg-soft);
    padding-top: 0.15em;
  }
  .panel__mark {
    display: none;
    place-items: center;
    padding: var(--s-6) var(--pad-x);
  }
  @media (min-width: 64rem) {
    .panel__mark {
      display: grid;
    }
  }
  .panel__mark svg {
    width: min(100%, 14rem);
  }
  .panel__accent {
    fill: var(--c-accent);
  }
</style>
