---
/** Large display heading for inner pages: `lines` + highlighted `accent`. */
interface Props {
  num: string;
  lines: string[];
  accent?: string;
  intro?: string;
}

const { num, lines, accent, intro } = Astro.props;
---

<header class="page-head">
  <p class="page-head__num">{num}</p>
  <h1 class="page-head__title display">
    {
      lines.map((line, i) => (
        <>
          {line}
          {i < lines.length - 1 || accent ? <br /> : null}
        </>
      ))
    }
    {accent && <><em>{accent}</em>.</>}
  </h1>
  {intro && <p class="page-head__intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding: calc(var(--header-h) + var(--s-8)) var(--pad-x) var(--s-6);
    border-bottom: var(--bw) solid var(--c-line);
    display: grid;
    gap: var(--s-5);
  }
  .page-head__num {
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--c-fg-soft);
  }
  .page-head__title {
    font-size: clamp(2.5rem, 10cqi, 9rem);
  }
  .page-head__intro {
    max-width: 48ch;
    font-size: clamp(1.0625rem, 1.6cqi, 1.375rem);
    line-height: 1.4;
  }
</style>
