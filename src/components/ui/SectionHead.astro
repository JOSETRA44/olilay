---
interface Props {
  num: string;
  title: string;
  count?: string;
  id?: string;
  as?: 'h1' | 'h2';
}

const { num, title, count, id, as: Tag = 'h2' } = Astro.props;
---

<div class="section-head">
  <p class="section-head__num">{num}</p>
  <Tag class="section-head__title" id={id}>{title}</Tag>
  {count && <p class="section-head__count">{count}</p>}
</div>

<style>
  .section-head {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-8) var(--pad-x) var(--s-5);
    border-bottom: var(--bw) solid var(--c-line);
  }
  @media (min-width: 48rem) {
    .section-head {
      grid-template-columns: minmax(9rem, auto) 1fr auto;
      align-items: end;
      gap: var(--s-5);
    }
  }
  .section-head__num,
  .section-head__count {
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--c-fg-soft);
  }
  .section-head__title {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(2rem, 6cqi, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }
</style>
