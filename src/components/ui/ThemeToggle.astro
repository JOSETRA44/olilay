---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={t.a11y.themeDark}>
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"></path>
  </svg>
</button>

<script>
  import { initThemeToggles } from '../../scripts/theme';
  initThemeToggles();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--bw) solid currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .theme-toggle:hover svg {
    transform: rotate(180deg);
  }
  .theme-toggle svg {
    transition: transform var(--dur-slow) var(--ease-out);
  }
</style>
