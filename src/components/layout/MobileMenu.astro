---
import { site } from '../../config/site';
import type { Locale } from '../../i18n/config';
import type { Alternates } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import LangSwitch from '../ui/LangSwitch.astro';
import type { NavItem } from './nav';

interface Props {
  locale: Locale;
  alternates: Alternates;
  items: NavItem[];
}

const { locale, alternates, items } = Astro.props;
const t = useTranslations(locale);
---

<!-- Native popover: Esc, light-dismiss and top-layer stacking without JS -->
<div class="menu" id="mobile-menu" popover>
  <div class="menu__bar">
    <span class="menu__brand">Olilay</span>
    <button class="menu__close" type="button" popovertarget="mobile-menu" popovertargetaction="hide" aria-label={t.a11y.closeMenu}>
      ×
    </button>
  </div>

  <nav aria-label={t.a11y.mainNav}>
    <ol class="menu__list">
      {
        items.map((item, i) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="menu__foot">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <LangSwitch locale={locale} alternates={alternates} />
  </div>
</div>

<style>
  .menu {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--pad-x) var(--s-5);
    border: 0;
    background: var(--c-inverse-bg);
    color: var(--c-inverse-fg);
    flex-direction: column;
    opacity: 0;
    translate: 0 -1rem;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out),
      display var(--dur-base) allow-discrete,
      overlay var(--dur-base) allow-discrete;
  }
  .menu:popover-open {
    display: flex;
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
      translate: 0 -1rem;
    }
  }

  .menu__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu__brand {
    font-family: var(--ff-display);
    font-size: 1.125rem;
    text-transform: uppercase;
  }
  .menu__close {
    width: 2.25rem;
    height: 2.25rem;
    border: var(--bw) solid currentColor;
    font-family: var(--ff-mono);
    font-size: 1.25rem;
    line-height: 1;
  }

  .menu__list {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    border-top: var(--bw) solid currentColor;
  }
  .menu__list li {
    border-bottom: var(--bw) solid currentColor;
  }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    font-family: var(--ff-display);
    font-size: clamp(2.25rem, 12cqi, 4rem);
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }
  .menu__list a[aria-current] {
    color: var(--lime);
  }
  .menu__num {
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    letter-spacing: 0;
    opacity: 0.6;
  }

  .menu__foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }
</style>
