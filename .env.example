# Copy to `.dev.vars` for local development (Cloudflare reads that file).
# In production use: npx wrangler secret put RESEND_API_KEY

# Resend API key (https://resend.com/api-keys). Without it the contact
# endpoint answers with a controlled "delivery unavailable" error.
RESEND_API_KEY=

# Optional overrides of the values in wrangler.jsonc `vars`.
# CONTACT_TO_EMAIL=ventas@olilay.com
# CONTACT_FROM_EMAIL=Olilay Web <web@olilay.com>
